{
	"name": "dec-streamflow",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
	// "remote": true makes `wrangler dev` use the real bucket instead of a local copy
	"r2_buckets": [{ "binding": "BUCKET", "bucket_name": "streamflow-gw-forecasts", "remote": true }]
}
